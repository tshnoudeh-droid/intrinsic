# FINNHUB_API_KEY is used only for search autocomplete
# yahoo-finance2 requires no API key
FINNHUB_API_KEY=

# GROQ_API_KEY powers the Intrinsic AI stock chatbot
GROQ_API_KEY=

# Upstash Redis — rate limits the chat endpoint. Required in production
# (fails closed without it); optional in local dev (fails open).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clerk post-auth redirects (also set in Vercel project env)
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/explore
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/explore
